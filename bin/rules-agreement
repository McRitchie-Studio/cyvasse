#!/usr/bin/env node
// Regenerate test/fixtures/files/rules_agreement.json from the JavaScript
// engine: the record the Ruby rules port (app/models/cyvasse_rules) is held
// to. Run after any change to app/javascript/cyvasse/{board,potential_range,
// rules,game,units}.js, then run both test lanes. See
// test/javascript/support/agreement.js.
import { writeFileSync } from "node:fs";
import { fileURLToPath } from "node:url";

// The shared importmap hook (needs node_modules/.studio-engine: bin/test-js or
// bin/rails studio:node:link makes it).
await import("../test/javascript/support/register.mjs");
const { buildAgreementFixture, serialize } = await import("../test/javascript/support/agreement.js");
const path = fileURLToPath(new URL("../test/fixtures/files/rules_agreement.json", import.meta.url));
writeFileSync(path, serialize(buildAgreementFixture()));
console.log(`wrote ${path}`);
