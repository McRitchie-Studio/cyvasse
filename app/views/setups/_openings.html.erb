<%# Twenty opening lineups (app/javascript/cyvasse/openings.js), open to every
    player: pick one, read its idea, load it onto the board. Locals: board,
    the board's Stimulus identifier (cyvasse-game or cyvasse-match), which
    places the loaded lineup. %>
<div class="space-y-2 border-t border-subtle pt-3"
     data-controller="cyvasse-openings"
     data-action="cyvasse-openings:load-><%= board %>#loadLineup">
  <h3 class="text-sm font-semibold uppercase tracking-widest text-muted">Openings</h3>
  <div class="flex gap-2">
    <label class="sr-only" for="<%= board %>-opening">Opening</label>
    <select id="<%= board %>-opening" class="input-field flex-1 min-w-0"
            data-cyvasse-openings-target="select" data-action="cyvasse-openings#choose"></select>
    <button type="button" class="btn btn-secondary shrink-0" data-action="cyvasse-openings#load">Load</button>
  </div>
  <p class="text-sm text-secondary" data-cyvasse-openings-target="idea"></p>
  <p class="text-sm text-secondary" role="status" aria-live="polite" hidden data-cyvasse-openings-target="message"></p>
</div>
