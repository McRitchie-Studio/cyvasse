<% content_for(:title, "Pieces · Cyvasse") %>

<section class="max-w-4xl mx-auto">
  <header class="mb-8">
    <h1 class="text-3xl font-extrabold text-heading tracking-tight mb-2">The Pieces</h1>
    <p class="text-secondary leading-relaxed max-w-2xl">
      All eleven Cyvasse pieces, each in both of the original skins: the pencil
      drawings and the coloured vector art.
    </p>
  </header>

  <div class="mb-6"><%= render "skins/toggle" %></div>

  <%# The skin in use leads, so the switcher visibly reorders the gallery. %>
  <div class="grid grid-cols-2 gap-3 sm:gap-6 border-b border-subtle pb-2 mb-6 text-xs font-semibold uppercase tracking-widest text-muted">
    <% @skins.each do |skin| %>
      <span data-skin-heading="<%= skin %>">
        <%= skin.to_s.capitalize %><% if skin == current_skin %> <span class="text-primary-700 dark:text-primary">· in use</span><% end %>
      </span>
    <% end %>
  </div>

  <div class="space-y-8">
    <% @pieces.each do |piece| %>
      <section id="<%= piece.slug %>" class="piece-row">
        <h2 class="text-lg font-bold text-heading mb-3"><%= piece.name %></h2>
        <div class="grid grid-cols-2 gap-3 sm:gap-6">
          <% @skins.each do |skin| %>
            <figure class="piece-tile" data-skin="<%= skin %>">
              <%= image_tag piece.image(skin), alt: "#{piece.name}, #{skin} skin", loading: "lazy", decoding: "async" %>
            </figure>
          <% end %>
        </div>
      </section>
    <% end %>
  </div>
</section>
