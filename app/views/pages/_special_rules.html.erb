<%# The four "Special Rules" cards from the original tutorial and in-game rules
    drawer (legacy features/tutorial.js and features/toggle.js). Each shows the
    units its rule is about as live Rulebook cards, with the stats in question
    marked. They replaced the tutorial's screenshots, whose numbers were baked
    into the image and went stale with every rule change (a Trebuchet that
    still moved 1 and shot 3). Every number in the copy is read from Rulebook
    too. A partial so the game screen can reuse it in a rules drawer. %>
<%# Each body is one or two short sentences, the one rule that matters; the
    unit card under it shows the numbers (Alex, 2026-09-29: "cut into a 1/3").
    The Cavalry card shows only the Heavy Horse ("people will get it"); the
    Units list below has both horses. %>
<% rules = [
     [ "range", "Range Units", [ [ Rulebook.fetch("trebuchet"), %i[range] ] ],
       "Range units shoot from a distance, and each turn they move or shoot, never both. " \
       "They defend at Strength #{Rulebook::RANGE_DEFENCE}." ],
     [ "cavalry", "Cavalry Units", [ [ Rulebook.fetch("heavyhorse"), %i[movement] ] ],
       "Cavalry units move or attack twice a turn." ],
     [ "dragon", "Your Dragon", [ [ Rulebook.fetch("dragon"), %i[movement strength] ] ],
       "A Dragon flies any distance in a straight line, and only a Trebuchet, Catapult, King or Dragon can take it. " \
       "Taking a Range unit ends its flight." ],
     [ "trump", "Trumps", [ [ Rulebook.fetch("rabble"), %i[strength trump] ] ],
       "Trumps work on attack only: a Rabble that attacks a King wins." ]
   ] %>
<div class="grid gap-4 sm:grid-cols-2">
  <% rules.each do |key, title, featured, body| %>
    <%# #rule-<key> is the anchor a Units-list stat links to (pages/_unit_card),
        and a deep link such as /rules#rule-trumps from anywhere. %>
    <article id="rule-<%= key == "trump" ? "trumps" : key %>" class="card p-4 special-rule-card flex flex-col gap-3" data-rule="<%= key %>">
      <h3 class="text-lg font-bold text-heading"><%= title %></h3>
      <p class="text-secondary leading-relaxed text-sm"><%= body %></p>
      <%# Should a card feature two units, they sit side by side, since each
          unit card is a tall portrait column. %>
      <div class="grid gap-3 mt-auto<%= " grid-cols-2" if featured.size > 1 %>">
        <% featured.each do |unit, highlight| %>
          <%= render "pages/unit_card", unit:, highlight: %>
        <% end %>
      </div>
    </article>
  <% end %>
</div>
