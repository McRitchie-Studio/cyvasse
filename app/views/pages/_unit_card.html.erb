<%# One unit's art and stats, read from Rulebook. The Units list gives each card
    an id; the Special Rules cards reuse it without one and pass `highlight`,
    the stats their rule is about (:movement, :strength, :range, :trump), which
    take the gold marker the old tutorial screenshots circled by hand.
    The card sizes itself to its column, not the screen (a container query in
    application.css): in a narrow column, such as the Units list's thirds, the
    art and name share a row and the stats take the card's full width below,
    so a long trump list wraps instead of squeezing beside the art.
    Locals: unit (Rulebook::Unit), id (optional), highlight (optional). %>
<% highlight = local_assigns.fetch(:highlight, []) %>
<% stats = [ [ :movement, "Movement", unit.movement ], [ :strength, "Strength", unit.strength ] ]
   stats << [ :range, "Range", unit.range ] if unit.range
   stats << [ :trump, "Trump", Rulebook.trump_list(unit) ] %>
<article <%= tag.attributes(id: local_assigns[:id]) %> class="unit-card card p-3" data-unit="<%= unit.slug %>">
  <div class="unit-card-body">
    <figure class="piece-tile unit-card-art shrink-0" data-skin="<%= current_skin %>">
      <%= image_tag unit.piece.image(current_skin), alt: unit.name, loading: "lazy", decoding: "async" %>
    </figure>
    <h4 class="unit-card-name text-lg font-bold text-heading leading-tight"><%= unit.name %></h4>
    <dl class="unit-stats text-sm grid grid-cols-[auto_1fr] gap-x-3 gap-y-0.5">
      <% stats.each do |key, label, value| %>
        <% marked = highlight.include?(key) %>
        <dt class="<%= marked ? "unit-stat-marked font-semibold text-heading" : "text-muted" %>" data-stat="<%= key %>"><%= label %></dt>
        <dd class="<%= marked ? "unit-stat-marked font-semibold text-heading" : "text-body" %>" data-stat="<%= key %>"><%= value %></dd>
      <% end %>
    </dl>
  </div>
</article>
