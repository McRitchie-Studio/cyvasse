<% seo_page :home, json_ld: [ video_game_json_ld, faq_json_ld ] %>
<% preload_modules "home" %>

<%# The art is one action shot per piece (HomeGallery), crossfading in turn; the black scrim keeps the white type legible in both themes. %>
<% content_for(:head) do %>
  <% first = @gallery.first %>
  <%# The same srcset and sizes as the first slide's <picture>, and no href, so the browser preloads the very file the slide will pick. %>
  <link rel="preload" as="image" imagesrcset="<%= home_gallery_srcset(first.wide_images) %>" imagesizes="<%= HomeGallery::SIZES %>" media="(min-width: 641px)" fetchpriority="high">
  <link rel="preload" as="image" imagesrcset="<%= home_gallery_srcset(first.portrait_images) %>" imagesizes="<%= HomeGallery::SIZES %>" media="(max-width: 640px)" fetchpriority="high">
<% end %>
<%# Full bleed: the layout's :hero slot puts it edge to edge under the navbar. %>
<% content_for(:hero) do %>
<section class="home-hero relative overflow-hidden"
         data-controller="home-gallery" data-home-gallery-interval-value="<%= HomeGallery::INTERVAL_MS %>">
  <%= render "pages/home_gallery", slides: @gallery %>
  <div class="home-hero-scrim relative px-4 py-16">
    <div class="w-full max-w-2xl mx-auto text-center">
      <h1 class="text-4xl font-extrabold text-white tracking-tight mb-4">Cyvasse</h1>
      <p class="text-white/85 leading-relaxed mb-8">
        The hexagonal strategy game is back on the board. Press Play Now for a
        live game, no account needed, or challenge a friend.
      </p>
      <div class="mb-6">
        <%= button_to "Play Now", live_seeks_path, class: "btn btn-primary btn-lg text-xl px-10", form: { class: "inline-block" } %>
      </div>
      <div class="flex flex-wrap justify-center gap-3 mb-6">
        <%= link_to "Rules", rules_path, class: "btn home-secondary-btn text-white" %>
        <%= link_to "Play a friend", matches_path, class: "btn home-secondary-btn text-white" %>
        <% unless logged_in? %>
          <%= link_to "Sign in", signin_path, class: "btn home-secondary-btn text-white" %>
        <% end %>
      </div>
      <% if logged_in? %>
        <p class="text-white/80">Signed in as <%= current_user.player_name %>.</p>
      <% end %>
      <div class="max-w-md mx-auto mt-10">
        <%= render "leaderboards/card", rows: @live_leaderboard %>
      </div>
    </div>
  </div>
  <%= render "pages/home_gallery_captions", slides: @gallery %>
</section>
<% end %>

<%# Below the hero, the words a search engine reads (task cyvasse-seo-profile):
    what Cyvasse is, how to play it here, and the FAQ, whose questions and
    answers are SeoPage.faq, the same text as the page's FAQPage JSON-LD. %>
<article class="home-intro max-w-3xl mx-auto py-12 space-y-10">
  <section id="what-is-cyvasse" class="rules-prose">
    <h2>The strategy game from <i>A Song of Ice and Fire</i></h2>
    <p>
      Cyvasse is the strategy board game from George R. R. Martin's
      <i>A Song of Ice and Fire</i>, the books behind <i>Game of Thrones</i>.
      Two players hide their armies behind a screen, set them up in secret on
      a hexagonal board, then lift the screen and fight until one King falls.
      The books name the pieces but never the rules, so this site gives the
      game a complete rulebook and lets you play it.
    </p>
    <p>
      Cyvasse is free to play online in your browser, with no account needed.
      Press <strong>Play Now</strong> for a live game against another player
      (a computer player steps in if nobody turns up), or challenge a friend
      by username. New to the game? The
      <%= link_to "rules", rules_path %> take a few minutes to learn, and the
      <%= link_to "pieces", pieces_path %> page shows every unit.
    </p>
  </section>

  <section id="faq" class="rules-prose">
    <h2>Questions</h2>
    <dl class="space-y-5">
      <% SeoPage.faq.each do |question, answer| %>
        <div>
          <dt class="font-semibold text-heading mb-1"><%= question %></dt>
          <dd class="text-secondary leading-relaxed"><%= answer %></dd>
        </div>
      <% end %>
    </dl>
  </section>
</article>
