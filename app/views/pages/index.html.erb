<% content_for(:title, "Cyvasse") %>
<% preload_modules "home" %>

<%# The art is one action shot per piece (HomeGallery), crossfading in turn; the black scrim keeps the white type legible in both themes. %>
<% content_for(:head) do %>
  <% first = @gallery.first %>
  <link rel="preload" as="image" href="<%= image_path(first.desktop_image) %>" media="(min-width: 641px)" fetchpriority="high">
  <link rel="preload" as="image" href="<%= image_path(first.mobile_image) %>" media="(max-width: 640px)" fetchpriority="high">
<% end %>
<section class="home-hero relative overflow-hidden rounded-2xl"
         data-controller="home-gallery" data-home-gallery-interval-value="<%= HomeGallery::INTERVAL_MS %>">
  <%= render "pages/home_gallery", slides: @gallery %>
  <div class="home-hero-scrim relative px-4 py-16">
    <div class="max-w-2xl mx-auto text-center">
      <h1 class="text-4xl font-extrabold text-white tracking-tight mb-4">Cyvasse</h1>
      <p class="text-white/85 leading-relaxed mb-8">
        The hexagonal strategy game is back on the board. Press Play Now for a
        live game, no account needed, or challenge a friend.
      </p>
      <div class="mb-6">
        <%= button_to "Play Now", live_seeks_path, class: "btn btn-primary btn-lg text-xl px-10", form: { class: "inline-block" } %>
      </div>
      <div class="flex flex-wrap justify-center gap-3 mb-6">
        <%= link_to "Rules", rules_path, class: "btn home-secondary-btn text-white" %>
        <%= link_to "Play a friend", matches_path, class: "btn home-secondary-btn text-white" %>
        <% unless logged_in? %>
          <%= link_to "Sign in", signin_path, class: "btn home-secondary-btn text-white" %>
        <% end %>
      </div>
      <% if logged_in? %>
        <p class="text-white/80">Signed in as <%= current_user.display_name %>.</p>
      <% end %>
      <div class="max-w-md mx-auto mt-10">
        <%= render "leaderboards/card", rows: @live_leaderboard %>
      </div>
    </div>
  </div>
  <%= render "pages/home_gallery_captions", slides: @gallery %>
</section>
