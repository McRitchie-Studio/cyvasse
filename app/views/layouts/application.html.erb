<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Cyvasse" %></title>
    <%= render "layouts/studio/head" %>
  </head>

  <body x-data class="bg-page text-body min-h-screen" :class="{ 'dev-mode': $store.devMode }">
    <%# The shared bar stack (environment, impersonation) sits BEFORE the navbar
        as its sibling, in normal flow; the navbar is the only pinned chrome
        (new-app-onboarding-sop.md section 7). %>
    <%= render "studio/banners/stack" %>
    <%= render "layouts/navbar" %>

    <main class="max-w-7xl mx-auto px-4 py-6">
      <%= render "layouts/studio/flash" %>
      <%= yield %>
    </main>
  </body>
</html>
