<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || "Cyvasse" %></title>
    <%= render "layouts/seo" %>
    <%= render "layouts/studio/head" %>
    <%# After the head, so after the import map: see ApplicationHelper#preload_modules. %>
    <%= yield :module_preloads %>
    <% if email_goal_url %><meta name="email-goal-url" content="<%= email_goal_url %>"><% end %>
  </head>

  <body x-data class="bg-page text-body min-h-screen" :class="{ 'dev-mode': $store.devMode }">
    <%# The shared bar stack (environment, impersonation) sits BEFORE the navbar
        as its sibling, in normal flow; the navbar is the only pinned chrome
        (new-app-onboarding-sop.md section 7). %>
    <%= render "studio/banners/stack" %>
    <%= render "layouts/navbar" %>
    <%# The signed-in player's own chat stream (task cyvasse-live-chat): the
        navbar's unread badge and the Chat hub's rows update over it
        (ChatBroadcasts, ChatStreamsChannel). %>
    <%= turbo_stream_from ChatStreams.user(current_user), channel: ChatStreamsChannel if respond_to?(:current_user) && current_user %>

    <%# A page's full-bleed band (the front door's hero), edge to edge
        directly under the navbar. It sits outside <main>'s centred
        container rather than breaking out of it with 100vw, which counts
        the scrollbar and scrolls the page sideways. %>
    <%= yield :hero %>

    <main class="max-w-7xl mx-auto px-4<%= " py-6" unless content_for?(:hero) %>">
      <%= render "layouts/studio/flash" %>
      <%= yield %>
      <% email_goal_beacons.each do |beacon| %><img src="<%= beacon %>" alt="" width="1" height="1" hidden data-email-beacon><% end %>
    </main>

    <%# The engine's modal host. Cyvasse's modals (game over, sign in) are
        registered in modals/_host_extras. Card widths by modal id, set
        before the host reads them. %>
    <script>
      window.StudioModals = window.StudioModals || {};
      window.StudioModals.CARD_WIDTHS = Object.assign({}, window.StudioModals.CARD_WIDTHS || {},
        { "game-over": "max-w-md", "auth": "max-w-md", "check-inbox": "max-w-md" });
    </script>
    <%= render "studio/modals/host" %>
  </body>
</html>
