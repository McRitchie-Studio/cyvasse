<%# What a search engine and a link preview read (SeoHelper, SeoPage). A page
    that named itself with seo_page gets its description, canonical, Open
    Graph and Twitter card and JSON-LD; every other page is noindex. %>
<link rel="apple-touch-icon" href="/icon.png">
<% if google_site_verification %>
  <meta name="google-site-verification" content="<%= google_site_verification %>">
<% end %>
<% if (page = current_seo_page) %>
  <meta name="description" content="<%= page.description %>">
  <meta name="robots" content="index, follow, max-image-preview:large">
  <link rel="canonical" href="<%= seo_canonical_url %>">
  <meta property="og:site_name" content="<%= SeoPage::SITE_NAME %>">
  <meta property="og:type" content="<%= page.key == :home ? "website" : "article" %>">
  <meta property="og:locale" content="en_US">
  <meta property="og:title" content="<%= page.title %>">
  <meta property="og:description" content="<%= page.description %>">
  <meta property="og:url" content="<%= seo_canonical_url %>">
  <meta property="og:image" content="<%= og_image %>">
  <meta property="og:image:width" content="<%= SeoHelper::OG_IMAGE_WIDTH %>">
  <meta property="og:image:height" content="<%= SeoHelper::OG_IMAGE_HEIGHT %>">
  <meta property="og:image:alt" content="A game of Cyvasse on the hexagonal board">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="<%= page.title %>">
  <meta name="twitter:description" content="<%= page.description %>">
  <meta name="twitter:image" content="<%= og_image %>">
  <%= json_ld_tag(website_json_ld) if page.key == :home %>
  <% if (trail = breadcrumb_json_ld) %><%= json_ld_tag(trail) %><% end %>
  <% seo_json_ld.each do |data| %><%= json_ld_tag(data) %><% end %>
<% else %>
  <meta name="robots" content="noindex">
<% end %>
