<%# What a search engine reads (SeoHelper, SeoPage). A page that named itself
    with seo_page gets its description, canonical and JSON-LD, and its words
    on the link-preview card; every other page is noindex. %>
<link rel="apple-touch-icon" href="/icon.png">
<% if google_site_verification %>
  <meta name="google-site-verification" content="<%= google_site_verification %>">
<% end %>
<% if (page = current_seo_page) %>
  <meta name="description" content="<%= page.description %>">
  <meta name="robots" content="index, follow, max-image-preview:large">
  <link rel="canonical" href="<%= seo_canonical_url %>">
  <%# The link-preview card is the engine's (studio-engine LINK_PREVIEW.md):
      this page's own words, and its own picture when it has one, else the
      site image from /admin/link_preview. layouts/studio/_head writes the
      tags, after this partial, so the override below reaches them. %>
  <% link_preview title: page.title, description: page.description, image: og_page_image %>
  <%= json_ld_tag(website_json_ld) if page.key == :home %>
  <% if (trail = breadcrumb_json_ld) %><%= json_ld_tag(trail) %><% end %>
  <% seo_json_ld.each do |data| %><%= json_ld_tag(data) %><% end %>
<% else %>
  <meta name="robots" content="noindex">
<% end %>
