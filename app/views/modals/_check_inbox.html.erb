<%# "Check your inbox" after a magic-link request from modals/_auth. Single
    root; the address rides in props.sentEmail. %>
<div x-data="{ get email() { var c = $store.modals.current(); return (c && c.props && c.props.sentEmail) || 'your email'; } }"
     class="relative text-center" data-test="check-inbox-modal">
  <%= render "studio/modals/blocks/card_header", icon_emoji: "📬", title: "Check your inbox" do %>
    We emailed a one-tap sign-in link to <span class="text-heading font-medium" x-text="email"></span>.
    It expires shortly and works once.
  <% end %>
  <p class="text-muted text-xs">No email? Check spam, or close this and try again.</p>
  <button type="button" @click="$store.modals.close()" class="btn btn-neutral btn-lg w-full mt-5">Done</button>
</div>
