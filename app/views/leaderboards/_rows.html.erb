<%# The ranked rows of a leaderboard (Leaderboard::Row). Locals: rows, and
    board ("live": points, wins, games; "all-time": wins, losses). Names
    truncate, so a long username never pushes the page sideways on a phone. %>
<ol class="leaderboard-rows is-<%= board %>" data-leaderboard-rows>
  <% rows.each do |row| %>
    <li class="leaderboard-row<%= ' is-you' if current_user && row.user.id == current_user.id %>" data-leaderboard-row="<%= row.user.username %>">
      <span class="leaderboard-rank" aria-label="Rank <%= row.rank %>" data-stat="rank"><%= row.rank %></span>
      <span class="leaderboard-name"><%= row.user.player_name %></span>
      <% if board == "live" %>
        <span class="leaderboard-stat" title="Points" data-stat="points"><strong class="text-heading"><%= row.points %></strong> <span class="text-muted"><%= row.points == 1 ? "pt" : "pts" %></span></span>
        <span class="leaderboard-stat" title="Wins" data-stat="wins"><%= row.wins %> <span class="text-muted">W</span></span>
        <span class="leaderboard-stat" title="Games finished" data-stat="games"><%= row.games %> <span class="text-muted">G</span></span>
      <% else %>
        <span class="leaderboard-stat" title="Wins" data-stat="wins"><strong class="text-heading"><%= row.wins %></strong> <span class="text-muted">W</span></span>
        <span class="leaderboard-stat" title="Losses" data-stat="losses"><%= row.losses %> <span class="text-muted">L</span></span>
      <% end %>
    </li>
  <% end %>
</ol>
