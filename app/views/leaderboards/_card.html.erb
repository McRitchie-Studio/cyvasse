<%# The landing page's live leaderboard: the top ten, or an invitation to be
    first. Locals: rows. %>
<section class="card p-4 text-left" data-leaderboard-card aria-labelledby="live-leaderboard-title">
  <div class="flex items-baseline justify-between gap-3 mb-3">
    <h2 id="live-leaderboard-title" class="text-sm font-semibold uppercase tracking-widest text-muted">Live leaderboard</h2>
    <%= link_to "See all", leaderboard_path, class: "text-sm text-secondary underline underline-offset-2" %>
  </div>
  <% if rows.empty? %>
    <p class="text-sm text-secondary" data-leaderboard-empty>
      Be the first on the board —
      <%= button_to "Play Now", live_seeks_path, class: "leaderboard-inline-cta", form: { class: "inline" } %>
    </p>
  <% else %>
    <%= render "leaderboards/rows", rows:, losses: false %>
  <% end %>
</section>
