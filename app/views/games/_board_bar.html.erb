<%# The strip above the board: the "start over" hint while a piece is picked
    (Esc on a keyboard, a tap target on touch) and the threat-outline switch.
    Locals: board, the board's Stimulus identifier (cyvasse-game or
    cyvasse-match); threats: false leaves the switch to the page. %>
<% threats = local_assigns.fetch(:threats, true) %>
<div class="cyvasse-board-bar">
  <button type="button" class="cyvasse-hint" hidden
          data-<%= board %>-target="hint" data-action="<%= board %>#startOver">
    <span class="cyvasse-hint-keys">Press <kbd>Esc</kbd> to start over</span>
    <span class="cyvasse-hint-touch">Start over</span>
  </button>
  <%= render "games/threat_toggle", board: board if threats %>
</div>
