<% left, right = @users %>
<% key = "#{left.id}-#{right.id}" %>
<% content_for(:title, "#{left.player_name} & #{right.player_name} · Admin · Cyvasse") %>

<section class="max-w-3xl mx-auto space-y-6">
  <header class="space-y-1 wrap-anywhere">
    <p class="text-sm text-secondary">
      <%= link_to "← Conversations", admin_conversations_path, class: "underline underline-offset-2" %>
      <% if @game %>
        · <%= link_to "Every game", admin_conversation_path(key), class: "underline underline-offset-2" %>
      <% end %>
    </p>
    <h1 class="text-2xl sm:text-3xl font-extrabold text-heading tracking-tight break-words">
      <%= left.player_name %> <span class="text-muted font-semibold">&amp;</span> <%= right.player_name %>
    </h1>
    <p class="text-sm text-secondary break-words" data-total>
      <%= pluralize(@total, "message") %><% unless @game %> in <%= pluralize(@page.total, "group") %>, newest game first<% end %>.
      <%= left.email %> · <%= right.email %>
    </p>
    <p class="text-xs text-muted" data-sides>
      <span class="font-semibold text-heading"><%= left.player_name %></span> on the left,
      <span class="font-semibold text-heading"><%= right.player_name %></span> on the right.
    </p>
  </header>

  <%= render partial: "admin/conversations/game", collection: @page.groups, as: :group,
        locals: { users: @users, conversation_key: key, whole: @game.present? } %>

  <%= render "messages/pager", page: @page, path: ->(n) { admin_conversation_path(key, game: @game, page: n) },
        prev_label: @game ? "← Earlier" : "← Newer games", next_label: @game ? "Later →" : "Older games →" %>
</section>
