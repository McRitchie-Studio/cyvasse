<% content_for(:title, "Match ##{@match.id} · Admin · Cyvasse") %>

<section class="max-w-3xl mx-auto space-y-6">
  <%# The engine page header (studio/_page_header): the old "Conversations" back
      link is the crumb trail. %>
  <%= render "studio/page_header",
        title: "Match ##{@match.id}: #{@match.home_user.player_name} vs #{@match.away_user.player_name}",
        crumb_label: "Match ##{@match.id}", crumbs: studio_crumbs(parent: :admin_conversations) %>

  <dl class="card p-4 grid grid-cols-[max-content_minmax(0,1fr)] gap-x-4 gap-y-1 text-sm wrap-anywhere" data-match-facts>
    <dt class="text-muted">Status</dt><dd class="text-heading"><%= @match.match_status %><%= " (#{@match.finish_reason})" if @match.finish_reason %></dd>
    <dt class="text-muted">Home</dt><dd><%= @match.home_user.player_name %> · <%= @match.home_user.email %></dd>
    <dt class="text-muted">Away</dt><dd><%= @match.away_user.player_name %> · <%= @match.away_user.email %></dd>
    <dt class="text-muted">Turn</dt><dd><%= @match.turn.to_i %></dd>
    <dt class="text-muted">Winner</dt><dd><%= @match.winner&.player_name || "none" %></dd>
    <dt class="text-muted">Started</dt><dd><%= l(@match.created_at, format: :long) %></dd>
    <dt class="text-muted">Last move</dt><dd><%= @match.time_of_last_move ? l(@match.time_of_last_move, format: :long) : "none" %></dd>
  </dl>

  <div class="card p-4 space-y-3">
    <h2 class="text-sm font-semibold uppercase tracking-widest text-muted">Chat (<%= @messages.size %>)</h2>
    <% if @messages.empty? %>
      <p class="text-sm text-secondary">No messages in this match.</p>
    <% else %>
      <ol class="chat-log is-thread" data-thread>
        <%= render partial: "messages/message", collection: @messages, as: :message %>
      </ol>
      <p class="text-sm">
        <%= link_to "The whole conversation", admin_conversation_path([ @match.home_user_id, @match.away_user_id ].minmax.join("-")), class: "underline underline-offset-2" %>
      </p>
    <% end %>
  </div>
</section>
