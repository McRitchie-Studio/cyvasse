<% content_for(:title, "Your username · Cyvasse") %>

<section class="max-w-md mx-auto card p-6 space-y-4">
  <h1 class="text-2xl font-extrabold text-heading tracking-tight">Your username</h1>
  <p class="text-secondary text-sm">
    Other players see this name and challenge you by it. 3 to 20 letters, digits or underscores.
  </p>
  <%= form_with url: username_path, method: :patch, class: "space-y-3" do |form| %>
    <%= hidden_field_tag :return_to, @return_to %>
    <div>
      <%= form.label :username, "Username", class: "block text-sm font-semibold text-heading mb-1" %>
      <%= form.text_field :username, value: params[:username] || current_user.username, required: true, autofocus: true,
            autocomplete: "username", autocapitalize: "none", spellcheck: false, maxlength: 20, class: "input-field w-full" %>
    </div>
    <% if current_user.errors[:username].any? %>
      <p class="text-sm" role="alert" style="color: var(--color-danger-ink, var(--color-danger))">
        Username <%= current_user.errors[:username].to_sentence %>.
      </p>
    <% end %>
    <%= form.submit "Save", class: "btn btn-primary" %>
  <% end %>
</section>
