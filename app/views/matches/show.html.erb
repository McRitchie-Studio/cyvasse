<% them = @opponent.player_name %>
<% content_for(:title, "#{current_user.player_name} vs #{them} · Cyvasse") %>
<% preload_modules "game" %>
<% content_for(:head) do %>
  <%= stylesheet_link_tag "game", "data-turbo-track": "reload" %>
  <%# A match moves on without this page: never restore a cached board. %>
  <meta name="turbo-cache-control" content="no-cache">
<% end %>

<%# returnTo: a guest signs in from the game-over modal and comes back here;
    the signed claim token takes their games along if the email link is
    opened in another browser (GuestClaim). %>
<section class="cyvasse-game max-w-6xl mx-auto"
         data-controller="cyvasse-match"
         data-match-status="<%= @match.match_status %>"
         data-action="keydown.esc@window->cyvasse-match#startOver click@window->cyvasse-match#clickAway"
         data-cyvasse-match-images-value="<%= @piece_images.to_json %>"
         data-cyvasse-match-state-value="<%= @state.to_json %>"
         data-cyvasse-match-state-url-value="<%= match_path(@match, format: :json) %>"
         data-cyvasse-match-setup-url-value="<%= setup_match_path(@match) %>"
         data-cyvasse-match-move-url-value="<%= moves_match_path(@match) %>"
         data-cyvasse-match-seat-url-value="<%= seat_match_path(@match) %>"
         <% if @match.live? %>data-cyvasse-match-poll-ms-value="1000" data-live="true"<% end %>
         <% if current_user.guest? %>data-cyvasse-match-return-to-value="<%= match_path(@match, claim: GuestClaim.token_for(current_user)) %>"<% end %>>
  <%# The versus card heads the sidebar; on a phone it sits above the board. %>
  <div class="cyvasse-layout match-layout">
    <%= render "matches/versus", me: current_user, opponent: @opponent, opponent_name: them %>

    <div class="cyvasse-board-wrap">
      <%= render "games/banner", board: "cyvasse-match" %>
      <%= render "games/board_bar", board: "cyvasse-match", threats: false %>
      <svg class="cyvasse-board" role="group" aria-label="The Cyvasse board. Arrow keys move between hexes; Enter selects."
           data-cyvasse-match-target="board" data-action="click->cyvasse-match#clickHex keydown->cyvasse-match#keyHex"></svg>
    </div>

    <%# The sidebar, top to bottom (task cyvasse-sidebar-reorder): the timer
        card (the live clock, the threat switches in play, the deadline and
        the notices); the army card in setup or the unit card in play; the
        status line; the fallen card and the chat; then the links and the
        forfeit, last. The status line is the board's one live region and
        never moves: during setup the army card shows an aria-hidden copy of
        it (armyStatus) and the line itself is read, not shown (game.css). %>
    <aside class="cyvasse-panel match-panel space-y-4">
      <div class="card p-4 flex flex-col gap-3 match-panel-status">
        <% if @match.live? %>
          <%# The live clock both players see (LiveMatch): setup, then each move. %>
          <div class="live-clock" hidden data-cyvasse-match-target="clock">
            <div class="flex items-baseline justify-between gap-3 text-sm">
              <span class="font-semibold text-heading" data-cyvasse-match-target="clockLabel"></span>
              <span class="live-clock-seconds" data-cyvasse-match-target="clockSeconds"></span>
            </div>
            <div class="live-clock-track"><span data-cyvasse-match-target="clockBar"></span></div>
          </div>
        <% end %>
        <%= render "games/threat_toggle", board: "cyvasse-match" %>
        <p class="text-sm text-secondary" hidden data-cyvasse-match-target="deadline"></p>
        <p class="cyvasse-alert" role="alert" hidden data-cyvasse-match-target="error"></p>
        <div class="live-notice" role="status" aria-live="polite" hidden data-cyvasse-match-target="notice">
          <span data-cyvasse-match-target="noticeText"></span>
          <button type="button" class="live-notice-dismiss" aria-label="Dismiss" hidden
                  data-cyvasse-match-target="noticeDismiss" data-action="cyvasse-match#dismissNotice">&times;</button>
        </div>
        <%# Shown while a computer holds this player's seat (LiveMatch#take_back_seat!). %>
        <div data-match-slot="take-back-seat" hidden data-cyvasse-match-target="takeBackSeat">
          <button type="button" class="btn btn-primary btn-sm" data-action="cyvasse-match#takeBackSeat">Take back my seat</button>
        </div>
      </div>

      <% if @state[:can_accept] %>
        <div class="card p-4 space-y-3">
          <h2 class="text-sm font-semibold uppercase tracking-widest text-muted">A challenge</h2>
          <p class="text-sm text-secondary"><%= @opponent.player_name %> wants a game. Accept, then set up your army.</p>
          <div class="flex flex-wrap gap-2">
            <%= button_to "Accept", accept_match_path(@match), class: "btn btn-primary" %>
            <%= button_to "Decline", match_path(@match), method: :delete, class: "btn btn-secondary",
                  form: { data: { turbo_confirm: "Decline #{@opponent.player_name}'s challenge?" } } %>
          </div>
        </div>
      <% end %>

      <div class="space-y-4 cyvasse-setup-controls" hidden data-cyvasse-match-target="setupControls">
        <%= render "games/army_card", board: "cyvasse-match", status: true,
              note: "Once you press Ready, your army is locked in; #{them} will not see it until the game starts.#{" When the clock runs out, your army is placed for you." if @match.live?}" %>
        <div class="card p-4 space-y-3">
          <%= render "setups/openings", board: "cyvasse-match" %>
          <%= render "setups/panel", board: "cyvasse-match", slots: @setup_slots %>
        </div>
      </div>

      <div class="card p-4" hidden data-cyvasse-match-target="info">
        <div class="flex items-center gap-3 mb-3">
          <div class="cyvasse-info-art" data-info="image"></div>
          <h2 class="text-lg font-bold text-heading" data-info="name"></h2>
        </div>
        <dl class="cyvasse-stats" data-info="stats"></dl>
        <p class="cyvasse-trump text-sm text-secondary mt-2" data-info="trump">Trumps <span></span></p>
      </div>

      <p class="card p-4 match-status-line text-secondary font-medium" role="status" aria-live="polite" data-cyvasse-match-target="status">Loading the board…</p>

      <%= render "games/fallen_card", board: "cyvasse-match", them: them %>

      <%# Chatting with a computer player goes nowhere. %>
      <%= render "matches/chat", match: @match, opponent: @opponent unless @opponent.computer? %>

      <%= render "matches/actions", match: @match, opponent_name: them, can_accept: @state[:can_accept] %>
    </aside>
  </div>
</section>
