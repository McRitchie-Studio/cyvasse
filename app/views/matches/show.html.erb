<% them = @match.display_name_of(@opponent) %>
<% content_for(:title, "#{current_user.username} vs #{them} · Cyvasse") %>
<% content_for(:head) do %>
  <%= stylesheet_link_tag "game", "data-turbo-track": "reload" %>
  <%# A match moves on without this page: never restore a cached board. %>
  <meta name="turbo-cache-control" content="no-cache">
<% end %>

<%# returnTo: a guest signs in from the game-over modal and comes back here;
    the signed claim token takes their games along if the email link is
    opened in another browser (GuestClaim). %>
<section class="cyvasse-game max-w-6xl mx-auto"
         data-controller="cyvasse-match"
         data-match-status="<%= @match.match_status %>"
         data-action="keydown.esc@window->cyvasse-match#startOver"
         data-cyvasse-match-images-value="<%= @piece_images.to_json %>"
         data-cyvasse-match-state-value="<%= @state.to_json %>"
         data-cyvasse-match-state-url-value="<%= match_path(@match, format: :json) %>"
         data-cyvasse-match-setup-url-value="<%= setup_match_path(@match) %>"
         data-cyvasse-match-move-url-value="<%= moves_match_path(@match) %>"
         <% if @match.live? %>data-cyvasse-match-poll-ms-value="1000" data-live="true"<% end %>
         <% if current_user.guest? %>data-cyvasse-match-return-to-value="<%= match_path(@match, claim: GuestClaim.token_for(current_user)) %>"<% end %>>
  <%# The versus row takes the whole top; everything else lives in the panel. %>
  <header class="match-top mb-4">
    <%= render "matches/versus", me: current_user, opponent: @opponent, opponent_name: them %>
  </header>

  <div class="cyvasse-layout match-layout">
    <div class="cyvasse-board-wrap">
      <%= render "games/board_bar", board: "cyvasse-match", threats: false %>
      <svg class="cyvasse-board" role="group" aria-label="The Cyvasse board. Arrow keys move between hexes; Enter selects."
           data-cyvasse-match-target="board" data-action="click->cyvasse-match#clickHex keydown->cyvasse-match#keyHex"></svg>
      <div class="cyvasse-banner" hidden data-cyvasse-match-target="banner"></div>
    </div>

    <aside class="cyvasse-panel match-panel space-y-4">
      <div class="card p-4 flex flex-col gap-3 match-panel-status">
        <% if @match.live? %>
          <%# The live clock both players see (LiveMatch): setup, then each move. %>
          <div class="live-clock" hidden data-cyvasse-match-target="clock">
            <div class="flex items-baseline justify-between gap-3 text-sm">
              <span class="font-semibold text-heading" data-cyvasse-match-target="clockLabel"></span>
              <span class="live-clock-seconds" data-cyvasse-match-target="clockSeconds"></span>
            </div>
            <div class="live-clock-track"><span data-cyvasse-match-target="clockBar"></span></div>
          </div>
        <% end %>
        <p class="text-secondary font-medium" role="status" aria-live="polite" data-cyvasse-match-target="status">Loading the board…</p>
        <p class="text-sm text-secondary" hidden data-cyvasse-match-target="deadline"></p>
        <p class="cyvasse-alert" role="alert" hidden data-cyvasse-match-target="error"></p>
        <p class="live-notice" role="status" aria-live="polite" hidden data-cyvasse-match-target="notice"></p>
        <%# Reserved for the "Take back my seat" control. %>
        <div data-match-slot="take-back-seat" hidden></div>
      </div>

      <div class="match-actions">
        <%= link_to "← My games", matches_path, class: "text-sm text-secondary underline underline-offset-2" %>
        <%= link_to "How to play", rules_path, class: "text-sm text-secondary underline underline-offset-2" %>
        <%= render "games/threat_toggle", board: "cyvasse-match" %>
        <%# Both forfeits render; CSS shows the one for data-match-status, which the board keeps current. %>
        <% if @match.pregame? && !@state[:can_accept] %>
          <span class="match-forfeit" data-forfeit="pregame">
            <%= button_to "Forfeit match", match_path(@match), method: :delete, class: "btn btn-secondary btn-sm",
                  form: { data: { turbo_confirm: "Forfeit this match? It is called off before it starts." } } %>
          </span>
        <% end %>
        <% if @match.pregame? || @match.in_progress? %>
          <span class="match-forfeit" data-forfeit="play">
            <%= button_to "Forfeit match", resign_match_path(@match), class: "btn btn-secondary btn-sm",
                  form: { data: { turbo_confirm: "Forfeit this match? #{them} wins." } } %>
          </span>
        <% end %>
      </div>

      <% if @state[:can_accept] %>
        <div class="card p-4 space-y-3">
          <h2 class="text-sm font-semibold uppercase tracking-widest text-muted">A challenge</h2>
          <p class="text-sm text-secondary"><%= @opponent.username %> wants a game. Accept, then set up your army.</p>
          <div class="flex flex-wrap gap-2">
            <%= button_to "Accept", accept_match_path(@match), class: "btn btn-primary" %>
            <%= button_to "Decline", match_path(@match), method: :delete, class: "btn btn-secondary",
                  form: { data: { turbo_confirm: "Decline #{@opponent.username}'s challenge?" } } %>
          </div>
        </div>
      <% end %>

      <div class="card p-4 space-y-3" hidden data-cyvasse-match-target="setupControls">
        <h2 class="text-sm font-semibold uppercase tracking-widest text-muted">Your army</h2>
        <p class="text-sm text-secondary">
          Pick a unit, then a lit hex in your five rows. Click a placed unit to move it again.
          Once you press Ready, your army is locked in; <%= them %> will not see it until the game starts.
          <% if @match.live? %>Watch the clock: when it runs out, your army is placed for you.<% end %>
        </p>
        <div class="cyvasse-dock" data-cyvasse-match-target="dock"></div>
        <div class="cyvasse-setup-actions">
          <button type="button" class="btn cyvasse-ready" disabled data-cyvasse-match-target="startButton" data-action="cyvasse-match#start">Ready</button>
          <button type="button" class="btn btn-outline btn-sm cyvasse-outline" data-action="cyvasse-match#randomSetup">Random Setup</button>
        </div>
        <%= render "setups/openings", board: "cyvasse-match" %>
        <%= render "setups/panel", board: "cyvasse-match", slots: @setup_slots %>
      </div>

      <div class="card p-4" hidden data-cyvasse-match-target="info">
        <div class="flex items-center gap-3 mb-3">
          <div class="cyvasse-info-art" data-info="image"></div>
          <h2 class="text-lg font-bold text-heading" data-info="name"></h2>
        </div>
        <dl class="cyvasse-stats" data-info="stats"></dl>
        <p class="cyvasse-trump text-sm text-secondary mt-2" data-info="trump">Trumps <span></span></p>
      </div>

      <div class="card p-4 space-y-3">
        <div>
          <h2 class="text-sm font-semibold uppercase tracking-widest text-muted mb-1">Your fallen</h2>
          <div class="cyvasse-graveyard" data-team="1" data-cyvasse-match-target="graveyard"></div>
        </div>
        <div>
          <h2 class="text-sm font-semibold uppercase tracking-widest text-muted mb-1"><%= them %>'s fallen</h2>
          <div class="cyvasse-graveyard" data-team="0" data-cyvasse-match-target="graveyard"></div>
        </div>
      </div>

      <%# Chatting with a computer player goes nowhere. %>
      <%= render "matches/chat", match: @match, opponent: @opponent unless @opponent.computer? %>
    </aside>
  </div>
</section>
