<% content_for(:title, "#{current_user.username} vs #{@opponent.username} · Cyvasse") %>
<% content_for(:head) do %>
  <%= stylesheet_link_tag "game", "data-turbo-track": "reload" %>
  <%# A match moves on without this page: never restore a cached board. %>
  <meta name="turbo-cache-control" content="no-cache">
<% end %>

<section class="cyvasse-game max-w-6xl mx-auto"
         data-controller="cyvasse-match"
         data-cyvasse-match-images-value="<%= @piece_images.to_json %>"
         data-cyvasse-match-state-value="<%= @state.to_json %>"
         data-cyvasse-match-state-url-value="<%= match_path(@match, format: :json) %>"
         data-cyvasse-match-setup-url-value="<%= setup_match_path(@match) %>"
         data-cyvasse-match-move-url-value="<%= moves_match_path(@match) %>">
  <header class="mb-4 flex flex-wrap items-baseline justify-between gap-2">
    <div>
      <p class="text-sm text-secondary"><%= link_to "← My games", matches_path, class: "underline underline-offset-2" %></p>
      <h1 class="text-3xl font-extrabold text-heading tracking-tight">
        <%= current_user.username %> <span class="text-muted font-semibold">vs</span>
        <span data-cyvasse-match-target="opponent"><%= @opponent.username %></span>
      </h1>
      <p class="text-sm text-secondary" hidden data-cyvasse-match-target="deadline"></p>
    </div>
    <p class="text-secondary font-medium" role="status" aria-live="polite" data-cyvasse-match-target="status">Loading the board…</p>
  </header>

  <p class="cyvasse-alert mb-4" role="alert" hidden data-cyvasse-match-target="error"></p>

  <div class="cyvasse-layout">
    <div class="cyvasse-board-wrap">
      <svg class="cyvasse-board" role="group" aria-label="The Cyvasse board"
           data-cyvasse-match-target="board" data-action="click->cyvasse-match#clickHex"></svg>
      <div class="cyvasse-banner" hidden data-cyvasse-match-target="banner"></div>
    </div>

    <aside class="cyvasse-panel space-y-4">
      <% if @state[:can_accept] %>
        <div class="card p-4 space-y-3">
          <h2 class="text-sm font-semibold uppercase tracking-widest text-muted">A challenge</h2>
          <p class="text-sm text-secondary"><%= @opponent.username %> wants a game. Accept, then set up your army.</p>
          <div class="flex flex-wrap gap-2">
            <%= button_to "Accept", accept_match_path(@match), class: "btn btn-primary" %>
            <%= button_to "Decline", match_path(@match), method: :delete, class: "btn btn-secondary",
                  form: { data: { turbo_confirm: "Decline #{@opponent.username}'s challenge?" } } %>
          </div>
        </div>
      <% end %>

      <div class="card p-4 space-y-3" hidden data-cyvasse-match-target="setupControls">
        <h2 class="text-sm font-semibold uppercase tracking-widest text-muted">Your army</h2>
        <p class="text-sm text-secondary">
          Pick a unit, then a lit hex in your five rows. Click a placed unit to move it again.
          Once submitted, your army is locked in; <%= @opponent.username %> will not see it until the game starts.
        </p>
        <div class="cyvasse-dock" data-cyvasse-match-target="dock"></div>
        <div class="flex flex-wrap gap-2">
          <button type="button" class="btn btn-secondary" data-action="cyvasse-match#randomSetup">Random Setup</button>
          <button type="button" class="btn btn-primary" hidden data-cyvasse-match-target="startButton" data-action="cyvasse-match#start">Submit army</button>
        </div>
      </div>

      <div class="card p-4" hidden data-cyvasse-match-target="info">
        <div class="flex items-center gap-3 mb-3">
          <div class="cyvasse-info-art" data-info="image"></div>
          <h2 class="text-lg font-bold text-heading" data-info="name"></h2>
        </div>
        <dl class="cyvasse-stats" data-info="stats"></dl>
        <p class="cyvasse-trump text-sm text-secondary mt-2" data-info="trump">Trumps <span></span></p>
      </div>

      <div class="card p-4 space-y-3">
        <div>
          <h2 class="text-sm font-semibold uppercase tracking-widest text-muted mb-1">Your fallen</h2>
          <div class="cyvasse-graveyard" data-team="1" data-cyvasse-match-target="graveyard"></div>
        </div>
        <div>
          <h2 class="text-sm font-semibold uppercase tracking-widest text-muted mb-1"><%= @opponent.username %>'s fallen</h2>
          <div class="cyvasse-graveyard" data-team="0" data-cyvasse-match-target="graveyard"></div>
        </div>
      </div>

      <div class="flex flex-wrap items-center gap-3">
        <% if @match.in_progress? %>
          <%= button_to "Resign", resign_match_path(@match), class: "btn btn-secondary",
                form: { data: { turbo_confirm: "Resign this match? #{@opponent.username} wins." } } %>
        <% elsif @match.pregame? && !@state[:can_accept] %>
          <%= button_to "Cancel match", match_path(@match), method: :delete, class: "btn btn-secondary",
                form: { data: { turbo_confirm: "Cancel this match with #{@opponent.username}?" } } %>
        <% end %>
        <%= link_to "How to play", rules_path, class: "text-sm text-secondary underline underline-offset-2" %>
      </div>
    </aside>
  </div>
</section>
