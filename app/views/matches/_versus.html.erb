<%# The match's versus card: you over them, each an avatar beside a name. Locals: me, opponent, opponent_name. %>
<% avatar_size = "w-11 h-11 text-base" %>
<div class="card match-versus-card">
  <h1 class="match-versus text-heading">
    <span class="match-versus-side" data-side="me">
      <%= render "players/avatar", user: me, name: me.player_name, size: avatar_size %>
      <span class="match-versus-name"><%= me.player_name %></span>
    </span>
    <span class="match-versus-vs text-muted">vs</span>
    <span class="match-versus-side" data-side="them">
      <%= render "players/avatar", user: opponent, name: opponent_name, size: avatar_size %>
      <span class="match-versus-who">
        <span class="match-versus-name" data-cyvasse-match-target="opponent"><%= opponent_name %></span>
        <% if opponent.computer? %><span class="match-versus-bot text-muted">Computer</span><% end %>
      </span>
    </span>
  </h1>
</div>
