<%# The match's versus line: [avatar] you  vs  them [avatar]. Locals: me, opponent, opponent_name. %>
<% avatar_size = "w-10 h-10 text-base sm:w-14 sm:h-14 sm:text-xl" %>
<h1 class="match-versus text-heading">
  <span class="match-versus-side" data-side="me">
    <%= render "players/avatar", user: me, name: me.username, size: avatar_size %>
    <span class="match-versus-name"><%= me.username %></span>
  </span>
  <span class="match-versus-vs text-muted">vs</span>
  <span class="match-versus-side match-versus-side-them" data-side="them">
    <span class="match-versus-name">
      <span data-cyvasse-match-target="opponent"><%= opponent_name %></span>
      <% if opponent.computer? %><span class="live-computer-tag">computer</span><% end %>
    </span>
    <%= render "players/avatar", user: opponent, name: opponent_name, size: avatar_size %>
  </span>
</h1>
