<% content_for(:title, "Finding an opponent · Cyvasse") %>
<% preload_modules "seek" %>
<section class="max-w-xl mx-auto text-center py-12 px-4"
         data-controller="live-seek"
         data-live-seek-url-value="<%= live_seek_path(@seek, format: :json) %>"
         data-live-seek-ends-at-value="<%= @seek.ends_at.iso8601(3) %>"
         data-live-seek-server-time-value="<%= Time.current.iso8601(3) %>"
         data-live-seek-splash-ms-value="<%= splash_ms %>"
         data-live-seek-you-value="<%= current_user.player_name %>">
  <%# The search reads at a narrow measure; the splash takes the section's
      wider one, so a 20-character username fits its card. %>
  <div class="max-w-md mx-auto" data-live-seek-target="searching">
    <div class="live-seek-radar mx-auto mb-6" aria-hidden="true">
      <span></span><span></span><span></span>
      <div class="live-seek-count" data-live-seek-target="count"><%= LiveSeek.search_time.to_i %></div>
    </div>
    <h1 class="text-2xl font-extrabold text-heading mb-2">Finding an opponent…</h1>
    <p class="text-secondary" role="status" aria-live="polite" data-live-seek-target="message">
      Looking for another player who wants a game right now. If no one turns up in time, you'll play a computer player.
    </p>
    <%= button_to "Play the computer now", computer_live_seek_path(@seek), class: "btn btn-secondary mt-6",
          form: { data: { action: "submit->live-seek#playComputer" } } %>
    <%= link_to "Cancel", root_path, class: "inline-block mt-4 text-sm text-secondary underline underline-offset-2" %>
  </div>

  <div class="live-seek-splash" hidden data-live-seek-target="splash" role="status" aria-live="assertive">
    <p class="text-sm uppercase tracking-widest text-muted mb-6">Match found</p>
    <%# The same faces as the match's versus card: players/avatar for both
        sides (the opponent's arrives rendered in the JSON), names by
        User#player_name, and a quiet small-caps caption, not a pill. %>
    <div class="live-seek-versus">
      <div class="live-seek-card" data-side="me">
        <%= render "players/avatar", user: current_user, name: current_user.player_name, size: LiveSeeksController::SPLASH_AVATAR_SIZE %>
        <div class="live-seek-name player-name text-heading" data-controller="name-fit" data-live-seek-target="you"></div>
        <div class="player-caption text-secondary">You</div>
      </div>
      <div class="live-seek-vs">VS</div>
      <div class="live-seek-card" data-side="them">
        <div class="live-seek-avatar-slot" data-live-seek-target="opponentAvatar">
          <span class="live-seek-avatar-pending w-14 h-14 rounded-full" data-avatar="pending"></span>
        </div>
        <div class="live-seek-name player-name text-heading" data-controller="name-fit" data-live-seek-target="opponent"></div>
        <div class="player-caption text-secondary" hidden data-live-seek-target="computerTag">Computer</div>
      </div>
    </div>
    <div class="live-seek-progress" aria-hidden="true"><span data-live-seek-target="progress"></span></div>
    <p class="text-secondary mt-4">Get ready…</p>
  </div>
</section>

<style>
  .live-seek-radar { position: relative; width: 11rem; height: 11rem; display: grid; place-items: center; border-radius: 9999px; box-shadow: inset 0 0 0 3px color-mix(in srgb, var(--color-cta, #8E82FE) 35%, transparent); }
  .live-seek-radar span { position: absolute; inset: 0; border-radius: 9999px; border: 3px solid var(--color-cta, #8E82FE); opacity: 0; animation: live-seek-ping 2.4s ease-out infinite; }
  .live-seek-radar span:nth-child(2) { animation-delay: 0.8s; }
  .live-seek-radar span:nth-child(3) { animation-delay: 1.6s; }
  .live-seek-count { font-size: 3.25rem; font-weight: 800; color: var(--color-text-heading, inherit); font-variant-numeric: tabular-nums; }
  @keyframes live-seek-ping { 0% { transform: scale(0.35); opacity: 0.9; } 100% { transform: scale(1); opacity: 0; } }
  .live-seek-splash { animation: live-seek-in 0.35s ease-out both; }
  .live-seek-versus { display: flex; align-items: center; justify-content: center; gap: 1rem; }
  .live-seek-card { flex: 1 1 0; min-width: 0; align-self: stretch; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 0.5rem; padding: 1.25rem 0.75rem; border-radius: 1rem; background: color-mix(in srgb, var(--color-cta, #8E82FE) 10%, transparent); border: 1px solid color-mix(in srgb, var(--color-cta, #8E82FE) 30%, transparent); }
  .live-seek-avatar-slot { display: grid; place-items: center; min-height: 3.5rem; }
  .live-seek-avatar-pending { display: block; border: 2px dashed color-mix(in srgb, var(--color-cta, #8E82FE) 45%, transparent); }
  .live-seek-card .player-caption { margin-top: -0.25rem; }
  .live-seek-name { font-size: 1.2rem; font-weight: 800; line-height: 1.2; }
  .live-seek-vs { font-size: 1.75rem; font-weight: 900; color: var(--color-cta, #8E82FE); flex: none; }
  .live-seek-progress { height: 4px; border-radius: 9999px; margin: 1.75rem auto 0; max-width: 18rem; background: color-mix(in srgb, var(--color-cta, #8E82FE) 18%, transparent); overflow: hidden; }
  .live-seek-progress span { display: block; height: 100%; width: 100%; background: var(--color-cta, #8E82FE); transform-origin: left; }
  /* A phone: room for a guest's whole name (Guest_1234) on one line; a longer
     username shrinks to fit (.player-name, the name-fit controller). */
  @media (max-width: 400px) { .live-seek-versus { gap: 0.5rem; } .live-seek-card { padding-inline: 0.375rem; } .live-seek-vs { font-size: 1.25rem; } .live-seek-name { font-size: 1.05rem; } }
  @keyframes live-seek-in { from { transform: scale(0.94); opacity: 0; } to { transform: none; opacity: 1; } }
  @media (prefers-reduced-motion: reduce) { .live-seek-radar span, .live-seek-splash { animation: none; } .live-seek-radar span { opacity: 0.3; } .live-seek-progress span { transition: none !important; } }
</style>
