<% content_for(:title, "#{@other.player_name} · Chat · Cyvasse") %>

<section class="max-w-3xl mx-auto space-y-4">
  <%# The engine page header (studio/_page_header): the old "Chat" back link is the
      crumb trail. The avatar stays beside the name, inside the title, hidden from
      a screen reader, which already reads the name. %>
  <%= render "studio/page_header",
        title: tag.span(class: "inline-flex items-center gap-3 align-middle") {
          tag.span(render("players/avatar", user: @other, size: "w-12 h-12 text-lg"), aria: { hidden: true }, class: "inline-flex") +
            tag.span(@other.player_name, class: "min-w-0")
        },
        crumb_label: @other.player_name, crumbs: studio_crumbs(parent: :chat) %>

  <div class="card p-4" data-thread>
    <%= render "chat/thread", thread: @thread, form_url: reply_conversation_path(@other.id), log_class: "is-hub" %>
  </div>
</section>
