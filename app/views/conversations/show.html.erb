<% content_for(:title, "#{@other.player_name} · Chat · Cyvasse") %>

<section class="max-w-3xl mx-auto space-y-4">
  <header class="space-y-3">
    <p class="text-sm text-secondary"><%= link_to "← Chat", conversations_path, class: "underline underline-offset-2" %></p>
    <div class="flex items-center gap-3">
      <%= render "players/avatar", user: @other, size: "w-12 h-12 text-lg" %>
      <h1 class="text-2xl sm:text-3xl font-extrabold text-heading tracking-tight min-w-0 truncate"><%= @other.player_name %></h1>
    </div>
  </header>

  <div class="card p-4" data-thread>
    <%= render "chat/thread", thread: @thread, form_url: reply_conversation_path(@other.id), log_class: "is-hub" %>
  </div>
</section>
