<% content_for(:title, "Chat · Cyvasse") %>

<section class="max-w-3xl mx-auto space-y-6">
  <header>
    <h1 class="text-3xl font-extrabold text-heading tracking-tight">Chat</h1>
    <p class="text-secondary">Your conversations with players you have played, newest first.</p>
  </header>

  <% if @page.total.zero? && @say_hi.empty? %>
    <div class="card p-6 sm:p-8 text-center space-y-4" data-chat-hub-empty>
      <p class="text-xl font-bold text-heading">Play a human to start a conversation</p>
      <p class="text-secondary">You can message anyone you have played a game against. Find an opponent and say hello.</p>
      <%= button_to "Play Now", live_seeks_path, class: "btn btn-primary btn-lg", form: { class: "inline-block" } %>
    </div>
  <% else %>
    <div class="space-y-2">
      <h2 class="text-sm font-semibold uppercase tracking-widest text-muted">Conversations</h2>
      <% if @page.total.zero? %>
        <p id="chat_hub_empty" class="text-secondary">No conversations yet. Say hi to someone you have played.</p>
      <% end %>
      <%# No whitespace inside the list: empty, it hides (empty:hidden) until a
          first message prepends a row (ChatBroadcasts). %>
      <ul id="chat_conversations" class="card divide-y divide-[var(--color-border)] empty:hidden" data-inbox><%= render partial: "conversations/row", collection: @page.conversations, as: :conversation, locals: { viewer: current_user } %></ul>
      <%= render "messages/pager", page: @page, path: ->(n) { conversations_path(page: n) } %>
    </div>

    <% if @say_hi.any? %>
      <div class="space-y-2">
        <h2 class="text-sm font-semibold uppercase tracking-widest text-muted">Say hi</h2>
        <p class="text-sm text-secondary">Players you have played and not messaged yet.</p>
        <ul id="chat_say_hi" class="card divide-y divide-[var(--color-border)]" data-say-hi-list>
          <%= render partial: "conversations/say_hi", collection: @say_hi, as: :person %>
        </ul>
      </div>
    <% end %>
  <% end %>
</section>
